{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!assets/|.*\\.(js|css|png|ico|svg|webmanifest|woff2?)$).*)", "destination": "/index.html" }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
